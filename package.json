{
  "name": "brainwires-opfs",
  "version": "0.1.0",
  "description": "Browse, edit, upload, and export files in any origin's OPFS from Chrome DevTools.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "package": "pnpm build && cd dist && zip -r ../brainwires-opfs.zip . -x '*.map'",
    "test": "pnpm test:unit && pnpm test:bridge && pnpm validate:dist",
    "test:unit": "vitest run",
    "test:bridge": "playwright test",
    "validate:dist": "node scripts/validate-dist.mjs",
    "setup": "git submodule update --init --recursive && pnpm setup:rsqlite",
    "setup:rsqlite": "cd vendor/rsqlite-wasm/js && npm install --no-audit --no-fund && npm run build",
    "preinstall": "node scripts/check-submodule.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.34.1",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.23.6",
    "class-variance-authority": "^0.7.0",
    "client-zip": "^2.4.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-scale-chromatic": "^3.1.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.6",
    "rsqlite-wasm": "file:./vendor/rsqlite-wasm/js",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.31",
    "@playwright/test": "^1.59.1",
    "@types/chrome": "^0.0.281",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale-chromatic": "^3.0.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.13.1"
}
